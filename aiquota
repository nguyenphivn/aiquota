#!/usr/bin/env python3
"""Show weekly Claude Code / Codex / Antigravity quota with a pace marker.

Usage: aiquota            print once
       aiquota -w [SEC]   redraw every SEC seconds (default 30)

Language: English by default, Vietnamese when AIQUOTA_LANG=vi
(or the locale is vi_*).

Extra Claude Code profiles in ~/.claude-*/ (CLAUDE_CONFIG_DIR) get their
own card.

Read-only: never writes to Claude Code, Codex or Antigravity credential/config
files.
"""
import glob
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.request
from datetime import datetime

WEEK = 7 * 24 * 3600
FIVE_HOURS = 5 * 3600
FETCH_TTL = 300  # the Claude usage endpoint rate-limits aggressively
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "aiquota")

RESET, DIM, BOLD = "\033[0m", "\033[2m", "\033[1m"
GREEN, YELLOW, RED, WHITE = "\033[32m", "\033[33m", "\033[31m", "\033[97m"

ANTIGRAVITY_TOKEN = os.path.expanduser("~/.gemini/antigravity-cli/antigravity-oauth-token")
CLOUDCODE = "https://cloudcode-pa.googleapis.com/v1internal:"

# Bar gradients from each brand: Claude peach→crail, Codex logo lavender→blue,
# Antigravity Gemini blue→violet→rose.
BRANDS = {
    "Claude": ["#DE7356", "#D97757", "#C15F3C"],
    "Codex": ["#B1A7FF", "#7A9DFF", "#3941FF"],
    "Antigravity": ["#4285F4", "#9B72CB", "#D96570"],
}
TRACK = "#2A2A2E"  # unused part of the bar, blended toward the brand below

STRINGS = {
    "en": {
        "units": ("d", "h", "m"),
        "on_pace": "● on pace",
        "ahead": "▲ %.0f%% ahead",
        "behind": "▼ %.0f%% behind",
        "exhausted": "used up",
        "runs_out": "runs out in %s",
        "lasts": "lasts until reset",
        "reset": "resets in %s",
        "stale": "%s old",
        "no_data": "no data",
        "http": "server returned %d",
        "token_expired": "token expired, open Claude Code once to refresh it",
        "codex_error": "unknown error",
        "codex_no_week": "no weekly limit found",
        "codex_silent": "codex did not answer",
        "five_hour": "5h window",
        "ag_token_expired": "token expired, open Antigravity once to refresh it",
        "ag_no_quota": "no model quota found",
        "footer": " updated %s · Ctrl+C to quit",
    },
    "vi": {
        "units": ("n", "g", "p"),
        "on_pace": "● đúng nhịp",
        "ahead": "▲ nhanh %.0f%%",
        "behind": "▼ chậm %.0f%%",
        "exhausted": "đã hết",
        "runs_out": "hết sau %s",
        "lasts": "đủ tới reset",
        "reset": "reset %s",
        "stale": "cũ %s",
        "no_data": "không lấy được số",
        "http": "máy chủ trả %d",
        "token_expired": "token hết hạn, mở Claude Code một lần để làm mới",
        "codex_error": "lỗi không rõ",
        "codex_no_week": "không thấy hạn mức tuần",
        "codex_silent": "codex không trả lời",
        "five_hour": "khung 5g",
        "ag_token_expired": "token hết hạn, mở Antigravity một lần để làm mới",
        "ag_no_quota": "không thấy hạn mức model",
        "footer": " cập nhật %s · Ctrl+C để thoát",
    },
}


def pick_lang():
    explicit = os.environ.get("AIQUOTA_LANG", "").lower()
    if explicit in STRINGS:
        return explicit
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var, "").lower().startswith("vi"):
            return "vi"
    return "en"


S = STRINGS[pick_lang()]


def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def gradient(stops, t):
    stops = [hex_rgb(s) for s in stops]
    if len(stops) == 1:
        return stops[0]
    pos = t * (len(stops) - 1)
    i = min(int(pos), len(stops) - 2)
    return mix(stops[i], stops[i + 1], pos - i)


def fg(rgb):
    return "\033[38;2;%d;%d;%dm" % rgb


def load_cache(name):
    try:
        with open(os.path.join(CACHE_DIR, name + ".json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_cache(name, data):
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, name + ".json")
    with open(path + ".tmp", "w") as f:
        json.dump(data, f)
    os.replace(path + ".tmp", path)


def iso_to_epoch(s):
    return datetime.fromisoformat(s).timestamp()


def claude_profiles():
    """(label, config dir, .claude.json path, cache name) per signed-in profile."""
    home = os.path.expanduser("~")
    profiles = [("", os.path.join(home, ".claude"), os.path.join(home, ".claude.json"), "claude")]
    # Profiles run with CLAUDE_CONFIG_DIR=~/.claude-<label> keep .claude.json inside the dir.
    for d in sorted(glob.glob(os.path.join(home, ".claude-*"))):
        label = os.path.basename(d)[len(".claude-"):]
        if os.path.isfile(os.path.join(d, ".credentials.json")) and re.fullmatch(r"[\w.-]+", label):
            profiles.append((label, d, os.path.join(d, ".claude.json"), "claude-" + label))
    return profiles


def claude_from_api(config_dir):
    with open(os.path.join(config_dir, ".credentials.json")) as f:
        oauth = json.load(f)["claudeAiOauth"]
    if oauth.get("expiresAt", 0) / 1000 < time.time():
        raise RuntimeError(S["token_expired"])
    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={
            "Authorization": "Bearer " + oauth["accessToken"],
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": "aiquota",
        },
    )
    with urllib.request.urlopen(req, timeout=10) as r:
        data = claude_window(json.load(r), time.time())
    return dict(data, fetched_at=time.time(), plan=oauth.get("subscriptionType") or "")


def claude_window(usage, fetched_at):
    week = usage.get("seven_day")
    if week:
        return {"used": float(week["utilization"]), "resets_at": iso_to_epoch(week["resets_at"])}
    # Team plans have no overall weekly cap, only the rolling 5-hour session.
    session = usage.get("five_hour") or {}
    if not session.get("resets_at"):
        # No session running yet: a fresh window would start now.
        return {"used": 0.0, "resets_at": fetched_at + FIVE_HOURS, "window": FIVE_HOURS}
    return {"used": float(session["utilization"]), "resets_at": iso_to_epoch(session["resets_at"]),
            "window": FIVE_HOURS}


def claude_from_claude_json(path):
    # Claude Code keeps its own last-seen utilization here; no network needed.
    with open(path) as f:
        cached = json.load(f)["cachedUsageUtilization"]
    fetched_at = cached["fetchedAtMs"] / 1000
    return dict(claude_window(cached["utilization"], fetched_at), fetched_at=fetched_at, plan="")


def get_claude(config_dir, claude_json, cache):
    cached = load_cache(cache)
    if cached and time.time() - cached.get("tried_at", 0) < FETCH_TTL:
        return cached, None
    try:
        data = claude_from_api(config_dir)
        data["tried_at"] = time.time()
        save_cache(cache, data)
        return data, None
    except urllib.error.HTTPError as e:
        err = S["http"] % e.code
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as e:
        err = str(e)
    # Fall back to whichever snapshot is newer, and back off before retrying.
    candidates = [c for c in (cached,) if c]
    try:
        candidates.append(claude_from_claude_json(claude_json))
    except (OSError, ValueError, KeyError, TypeError):
        pass
    if not candidates:
        return None, err
    best = max(candidates, key=lambda c: c["fetched_at"])
    best = dict(best, tried_at=time.time())
    save_cache(cache, best)
    return best, err


def codex_from_app_server():
    env = {k: v for k, v in os.environ.items() if k != "CODEX_API_KEY"}  # force the ChatGPT login
    p = subprocess.Popen(
        ["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, text=True, env=env,
    )
    try:
        for msg in (
            {"method": "initialize", "id": 0,
             "params": {"clientInfo": {"name": "aiquota", "title": "aiquota", "version": "1"}}},
            {"method": "initialized"},
            {"method": "account/rateLimits/read", "id": 1, "params": {}},
        ):
            p.stdin.write(json.dumps(msg) + "\n")
        p.stdin.flush()
        deadline = time.time() + 20
        while time.time() < deadline:
            ready, _, _ = select.select([p.stdout], [], [], 1)
            if not ready:
                continue
            line = p.stdout.readline()
            if not line:
                break
            msg = json.loads(line)
            if msg.get("id") != 1:
                continue
            if "error" in msg:
                raise RuntimeError(msg["error"].get("message", S["codex_error"]))
            limits = msg["result"]["rateLimits"]
            windows = [w for w in (limits.get("primary"), limits.get("secondary")) if w]
            week = next((w for w in windows if w.get("windowDurationMins") == 10080), None)
            if week is None:
                raise RuntimeError(S["codex_no_week"])
            return {
                "used": float(week["usedPercent"]),
                "resets_at": float(week["resetsAt"]),
                "fetched_at": time.time(),
                "plan": limits.get("planType") or "",
            }
        raise RuntimeError(S["codex_silent"])
    finally:
        p.kill()
        p.wait()


def cloudcode_call(token, method, body):
    req = urllib.request.Request(
        CLOUDCODE + method, data=json.dumps(body).encode(), method="POST",
        headers={
            "Authorization": "Bearer " + token,
            "Content-Type": "application/json",
            # The server answers by client: other user agents get "unsupported client".
            "User-Agent": "antigravity",
        },
    )
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)


def antigravity_from_api():
    with open(ANTIGRAVITY_TOKEN) as f:
        token = json.load(f)["token"]
    # Go writes nanoseconds; older Pythons only parse up to microseconds.
    expiry = re.sub(r"(\.\d{6})\d+", r"\1", token["expiry"])
    if iso_to_epoch(expiry) < time.time():
        raise RuntimeError(S["ag_token_expired"])
    access = token["access_token"]
    assist = cloudcode_call(access, "loadCodeAssist", {"metadata": {
        "ideType": "ANTIGRAVITY", "platform": "PLATFORM_UNSPECIFIED", "pluginType": "GEMINI"}})
    project = assist.get("cloudaicompanionProject")
    found = cloudcode_call(access, "fetchAvailableModels", {"project": project} if project else {})
    models = found.get("models", {})
    # Agent models offered in the picker; tab-completion models have no reset time.
    ids = [i for sort in found.get("agentModelSorts", []) for g in sort.get("groups", [])
           for i in g.get("modelIds", [])] or list(models)
    default = found.get("defaultAgentModelId")
    best = None
    for mid in ids:
        quota = models.get(mid, {}).get("quotaInfo") or {}
        if "resetTime" not in quota:
            continue
        # remainingFraction is omitted once a model is used up.
        left = float(quota.get("remainingFraction", 0))
        key = (left, mid != default)
        if best is None or key < best[0]:
            best = (key, mid, quota)
    if best is None:
        raise RuntimeError(S["ag_no_quota"])
    _, mid, quota = best
    tier = assist.get("paidTier") or assist.get("currentTier") or {}
    return {
        "used": (1 - float(quota.get("remainingFraction", 0))) * 100,
        "resets_at": iso_to_epoch(quota["resetTime"].replace("Z", "+00:00")),
        "fetched_at": time.time(),
        "plan": tier.get("id") or "",
        "note": models[mid].get("displayName") or mid,
    }


def get_cached(name, fetch):
    cached = load_cache(name)
    if cached and time.time() - cached.get("tried_at", 0) < FETCH_TTL:
        return cached, None
    try:
        data = fetch()
        data["tried_at"] = time.time()
        save_cache(name, data)
        return data, None
    except urllib.error.HTTPError as e:
        err = S["http"] % e.code
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as e:
        err = str(e)
    if cached:
        save_cache(name, dict(cached, tried_at=time.time()))
    return cached, err


def get_codex():
    return get_cached("codex", codex_from_app_server)


def get_antigravity():
    return get_cached("antigravity", antigravity_from_api)


def fmt_dur(sec):
    d_u, h_u, m_u = S["units"]
    sec = max(0, int(sec))
    d, rem = divmod(sec, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return "%d%s %d%s" % (d, d_u, h, h_u)
    if h:
        return "%d%s %d%s" % (h, h_u, m, m_u)
    return "%d%s" % (m, m_u)


ANSI = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def vis_len(s):
    """Terminal cell width of s, ignoring ANSI escapes."""
    n = 0
    for ch in ANSI.sub("", s):
        if unicodedata.combining(ch):
            continue
        n += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return n


def wrap_segments(segments, width, sep=" · "):
    """Greedy-wrap pre-colored phrases so a line never breaks mid-phrase."""
    lines, cur = [], ""
    sep_len = vis_len(sep)
    for seg in segments:
        if not cur:
            cur = seg
        elif vis_len(cur) + sep_len + vis_len(seg) <= width:
            cur += DIM + sep + RESET + seg
        else:
            lines.append(cur)
            cur = seg
    if cur:
        lines.append(cur)
    return lines


def make_bar(stops, used, expected, width):
    track = hex_rgb(TRACK)
    fill = round(used / 100 * width)
    mark = min(width - 1, int(expected / 100 * width))
    cells = []
    for i in range(width):
        shade = gradient(stops, i / max(1, width - 1))
        if i == mark:
            cells.append(BOLD + WHITE + ("┃" if i >= fill else "▌") + RESET)
        elif i < fill:
            cells.append(fg(shade) + "█" + RESET)
        else:
            cells.append(fg(mix(track, shade, 0.25)) + "█" + RESET)
    return "".join(cells)


def card_body(name, data, err, now, inner):
    """Content lines for one provider, each at most `inner` cells wide."""
    if data is None:
        return wrap_segments([RED + S["no_data"] + RESET, DIM + str(err) + RESET], inner)

    used = max(0.0, min(100.0, data["used"]))
    left = data["resets_at"] - now
    window = data.get("window", WEEK)
    elapsed = max(0.0, min(1.0, 1 - left / window))
    expected = elapsed * 100
    diff = used - expected

    if used >= 90 or diff > 10:
        color = RED
    elif diff > 0:
        color = YELLOW
    else:
        color = GREEN

    pct = "%s%s%3.0f%%%s" % (color, BOLD, used, RESET)
    bar_w = max(8, inner - vis_len(pct) - 1)
    lines = [make_bar(BRANDS.get(name, ["#AAAAAA"]), used, expected, bar_w) + " " + pct]

    if abs(diff) < 1:
        pace = S["on_pace"]
    elif diff > 0:
        pace = color + S["ahead"] % diff + RESET
    else:
        pace = GREEN + S["behind"] % -diff + RESET
    info = [pace]
    if used >= 100:
        info.append(RED + S["exhausted"] + RESET)
    elif elapsed > 0.02 and used > 0:
        runout = (100 - used) / (used / (elapsed * window))
        if runout < left:
            info.append(RED + S["runs_out"] % fmt_dur(runout) + RESET)
        else:
            info.append(GREEN + S["lasts"] + RESET)
    info.append(S["reset"] % fmt_dur(left))
    if window == FIVE_HOURS:
        info.append(DIM + S["five_hour"] + RESET)
    if data.get("note"):
        info.append(DIM + data["note"] + RESET)
    # Only flag data that is clearly stale; the fetch error itself is noise here.
    age = now - data["fetched_at"]
    if age > 900:
        info.append(DIM + S["stale"] % fmt_dur(age) + RESET)
    lines += wrap_segments(info, inner)
    return lines


def box(title, body, width, border_rgb):
    """Rounded frame with the title embedded in the top edge."""
    b = fg(border_rgb)
    inner = width - 4
    top_fill = max(0, width - 3 - vis_len(title) - 2)
    out = [b + "╭─ " + RESET + title + b + " " + "─" * top_fill + "╮" + RESET]
    for line in body:
        pad = max(0, inner - vis_len(line))
        out.append(b + "│" + RESET + " " + line + " " * pad + " " + b + "│" + RESET)
    out.append(b + "╰" + "─" * (width - 2) + "╯" + RESET)
    return out


def draw(width):
    now = time.time()
    width = max(30, min(width, 72))
    out = []
    cards = [("Claude", label, lambda p=p: get_claude(*p))
             for label, *p in claude_profiles()]
    cards.append(("Codex", "", get_codex))
    if os.path.exists(ANTIGRAVITY_TOKEN):
        cards.append(("Antigravity", "", get_antigravity))
    for name, label, getter in cards:
        data, err = getter()
        stops = BRANDS.get(name, ["#AAAAAA"])
        brand = gradient(stops, 0.5)
        title = fg(brand) + BOLD + name + RESET
        if label:
            title += fg(brand) + " " + label + RESET
        if data and data.get("plan"):
            title += DIM + " · " + data["plan"] + RESET
        border = mix(hex_rgb(TRACK), brand, 0.6)
        out += box(title, card_body(name, data, err, now, width - 4), width, border)
    return out


def term_width():
    return shutil.get_terminal_size((80, 24)).columns


def watch(interval):
    resized = {"flag": False}
    signal.signal(signal.SIGWINCH, lambda *_: resized.update(flag=True))
    # Alternate screen + hidden cursor, restored on any exit path.
    sys.stdout.write("\033[?1049h\033[?25l")
    try:
        while True:
            lines = draw(term_width() - 1)
            lines.append(DIM + S["footer"] % time.strftime("%H:%M:%S") + RESET)
            sys.stdout.write("\033[H" + "".join(l + "\033[K\n" for l in lines) + "\033[J")
            sys.stdout.flush()
            resized["flag"] = False
            deadline = time.time() + interval
            while time.time() < deadline and not resized["flag"]:
                time.sleep(0.2)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if args and args[0] in ("-w", "--watch"):
        try:
            interval = int(args[1]) if len(args) > 1 else 30
        except ValueError:
            sys.exit("aiquota: interval must be a whole number of seconds")
        watch(max(1, interval))
        return
    print("\n".join(draw(term_width() - 1)))


if __name__ == "__main__":
    main()
